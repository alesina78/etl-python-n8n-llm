cat << 'EOF' > .gitignore
# Ambiente virtual Python
venv/
Lib/
Scripts/
Include/
pyvenv.cfg
__pycache__/
*.pyc

# Banco de dados e dados locais
data/
*.sqlite
*.db

# Credenciais e configurações sensíveis
.env
src/.env

# Arquivos temporários, prints e docs pessoais
*.png
*.docx
.DS_Store
Thumbs.db
EOF