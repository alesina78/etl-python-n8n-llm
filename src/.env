# Define a String de Conexão (DSN - Data Source Name) com o banco de dados.
# Por padrão, se a variável DB_DSN não estiver definida no .env, 
# ela utiliza o SQLite local apontando para a pasta data/demo.sqlite.
DB_DSN = os.getenv("DB_DSN", "sqlite:///data/demo.sqlite")

# Chave de API da OpenAI, necessária exclusivamente na etapa 'Gold' do ETL
# onde ocorre o enriquecimento e classificação inteligente de dados via LLM.
OPENAI_API_KEY = os.getenv("OPENAI_API_KEY")